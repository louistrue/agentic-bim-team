<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>Swiss Residential Minimum — BIM Agent Team</title>
    <copyright>BIM Agent Team</copyright>
    <version>1.0</version>
    <description>Minimum IDS requirements for Swiss residential buildings generated by the BIM agent team. Based on SIA 416, SIA 380/1, and Swiss BZO requirements.</description>
    <author>bim-agent-team</author>
    <date>2025-03-22</date>
    <purpose>Validate that agent-generated IFC files meet minimum data quality for Swiss residential projects.</purpose>
  </info>

  <specifications>

    <!-- 1. Every IfcSpace must have NetFloorArea (SIA 416) -->
    <specification name="Space has NetFloorArea" ifcVersion="IFC4" necessity="required">
      <applicability>
        <entity>
          <name>
            <simpleValue>IFCSPACE</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCAREAMEASURE" necessity="required">
          <propertySet>
            <simpleValue>Qto_SpaceBaseQuantities</simpleValue>
          </propertySet>
          <baseName>
            <simpleValue>NetFloorArea</simpleValue>
          </baseName>
        </property>
      </requirements>
    </specification>

    <!-- 2. External walls must have material assignment -->
    <specification name="External wall has material" ifcVersion="IFC4" necessity="required">
      <applicability>
        <entity>
          <name>
            <simpleValue>IFCWALL</simpleValue>
          </name>
        </entity>
        <property dataType="IFCBOOLEAN">
          <propertySet>
            <simpleValue>Pset_WallCommon</simpleValue>
          </propertySet>
          <baseName>
            <simpleValue>IsExternal</simpleValue>
          </baseName>
          <value>
            <simpleValue>TRUE</simpleValue>
          </value>
        </property>
      </applicability>
      <requirements>
        <material necessity="required"/>
      </requirements>
    </specification>

    <!-- 3. Every wall must have LoadBearing property -->
    <specification name="Wall has LoadBearing" ifcVersion="IFC4" necessity="required">
      <applicability>
        <entity>
          <name>
            <simpleValue>IFCWALL</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCBOOLEAN" necessity="required">
          <propertySet>
            <simpleValue>Pset_WallCommon</simpleValue>
          </propertySet>
          <baseName>
            <simpleValue>LoadBearing</simpleValue>
          </baseName>
        </property>
      </requirements>
    </specification>

    <!-- 4. Building must have GrossFloorArea -->
    <specification name="Building has GrossFloorArea" ifcVersion="IFC4" necessity="required">
      <applicability>
        <entity>
          <name>
            <simpleValue>IFCBUILDING</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCAREAMEASURE" necessity="required">
          <propertySet>
            <simpleValue>Qto_BuildingBaseQuantities</simpleValue>
          </propertySet>
          <baseName>
            <simpleValue>GrossFloorArea</simpleValue>
          </baseName>
        </property>
      </requirements>
    </specification>

    <!-- 5. Building storeys must have Name -->
    <specification name="Storey has Name" ifcVersion="IFC4" necessity="required">
      <applicability>
        <entity>
          <name>
            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute necessity="required">
          <name>
            <simpleValue>Name</simpleValue>
          </name>
        </attribute>
      </requirements>
    </specification>

    <!-- 6. Project must reference coordinate system -->
    <specification name="Project has coordinate reference" ifcVersion="IFC4" necessity="required">
      <applicability>
        <entity>
          <name>
            <simpleValue>IFCPROJECT</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute necessity="required">
          <name>
            <simpleValue>Name</simpleValue>
          </name>
        </attribute>
      </requirements>
    </specification>

  </specifications>
</ids>
